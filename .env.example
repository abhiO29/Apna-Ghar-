# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to git.

# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Production security settings — leave all of these unset/default for local
# dev (plain HTTP). Only set these once this is deployed behind real HTTPS;
# turning SECURE_SSL_REDIRECT or the *_COOKIE_SECURE flags on over plain
# HTTP will lock you out (redirect loops / cookies silently never sent).
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=True
# DJANGO_X_FRAME_OPTIONS=DENY
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.example

# --- PythonAnywhere example (replace YOURNAME) ---
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=YOURNAME.pythonanywhere.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://YOURNAME.pythonanywhere.com
# DJANGO_BEHIND_PROXY=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DB_NAME=YOURNAME$apnaghar_db
# DB_USER=YOURNAME
# DB_HOST=YOURNAME.mysql.pythonanywhere-services.com

# MySQL database
DB_NAME=apnaghar_db
DB_USER=apnaghar_user
DB_PASSWORD=change-this-password
DB_HOST=127.0.0.1
DB_PORT=3306
